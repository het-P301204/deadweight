{
  "name": "deadweight",
  "version": "0.1.0",
  "private": true,
  "description": "AI model and skill supply-chain analyzer. Answers one question about every AI artifact a codebase loads: what happens when it is loaded?",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "deadweight": "bin/deadweight.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "deadweight": "node bin/deadweight.ts",
    "fixtures": "node scripts/make-fixtures.ts",
    "demo-tree": "node scripts/demo-tree.ts",
    "error-pages": "node scripts/error-pages.ts",
    "docs-numbers": "node scripts/docs-numbers.ts",
    "screenshots": "node scripts/screenshots.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && node scripts/make-fixtures.ts --check && node scripts/demo-tree.ts --check && node scripts/error-pages.ts --check && node scripts/docs-numbers.ts --check && npm run assert-claims",
    "assert-claims": "node scripts/assert-claims.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.14",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
